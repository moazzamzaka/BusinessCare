---
import { clients } from '../data/site';

// Duplicated once so the CSS marquee can loop seamlessly at -50%.
const group = [...clients];
---

<section class="section--tight" aria-label="Organisations we have worked with">
  <div class="wrap">
    <p class="marquee__label" data-reveal>
      Ten years of shipping, for teams across healthcare, finance, telecom and government.
    </p>
  </div>
  <div class="marquee">
    <div class="marquee__track">
      {[0, 1].map(() => (
        <div class="marquee__group" aria-hidden="true">
          {group.map((name) => (
            <span class="marquee__item">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M4 12h16M12 4v16" stroke-linecap="round" />
              </svg>
              {name}
            </span>
          ))}
        </div>
      ))}
    </div>
  </div>
</section>
