---
/**
 * Neutral wordmark placeholder used in the brand lockup. Deliberately
 * generic — swap for a real logo later.
 */
interface Props {
  name?: string;
  size?: number;
  showText?: boolean;
}

const { name = 'BusinessCare', size = 26, showText = true } = Astro.props;
const uid = `m${Math.random().toString(36).slice(2, 9)}`;

// Deterministic hue so each label gets a stable colour across renders.
let hash = 0;
for (let i = 0; i < name.length; i++) hash = (hash * 31 + name.charCodeAt(i)) % 360;
const hue = hash;
---

<span class="brand">
  <svg
    class="brand__mark"
    width={size}
    height={size}
    viewBox="0 0 32 32"
    aria-hidden="true"
    xmlns="http://www.w3.org/2000/svg"
    style={`--h:${hue}`}
  >
    <defs>
      <linearGradient id={`${uid}-g`} x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color={`hsl(${hue} 85% 68%)`} />
        <stop offset="1" stop-color={`hsl(${(hue + 40) % 360} 80% 56%)`} />
      </linearGradient>
    </defs>
    <rect width="32" height="32" rx="9" fill={`url(#${uid}-g)`} />
    <path
      d="M9 22V11.5c0-.3.4-.5.6-.3l6.9 8.3c.4.5 1.2.2 1.2-.4V10"
      fill="none"
      stroke="#0b0d26"
      stroke-width="2.6"
      stroke-linecap="round"
      stroke-linejoin="round"
      opacity="0.85"
    />
  </svg>
  {showText && <span class="brand__text">{name}</span>}
</span>
