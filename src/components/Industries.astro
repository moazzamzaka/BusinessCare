---
import Art from './Art.astro';
import { industries } from '../data/site';
---

<section class="section" id="industries">
  <div class="wrap">
    <div class="section__head" data-reveal>
      <span class="eyebrow">Industries</span>
      <h2 class="h2">Built with the organisations that run cities and economies.</h2>
      <p class="lede">
        Banks, health systems, telecom operators, transport networks and governments. Each
        engagement starts with the workflow that hurts most.
      </p>
    </div>

    <div class="industries">
      {industries.map((ind, i) => (
        <article class="industry" tabindex="0" data-reveal style={`--d:${i * 50}ms`}>
          <span class="industry__art" aria-hidden="true">
            <Art hue={ind.hue} variant="card" label="" />
          </span>
          <h3>{ind.name}</h3>
          <ul>
            {ind.items.map((it) => <li>{it}</li>)}
          </ul>
        </article>
      ))}
    </div>
  </div>
</section>
